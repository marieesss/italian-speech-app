# Copy to .env and fill in. Never committed.

DB_CONNECTION=Host=localhost;Port=5434;Database=italianapp;Username=italianapp;Password=italianapp

# openssl rand -base64 48
JWT_SIGNING_SECRET=
JWT_ISSUER=italian-app
JWT_AUDIENCE=italian-app
JWT_LIFETIME_HOURS=72

# Set to false once the account exists.
IDENTITY_ALLOW_REGISTRATION=true
# Comma-separated. Only these may read /api/admin/usage.
IDENTITY_ADMIN_EMAILS=

AZURE_SPEECH_SUBSCRIPTION=
AZURE_SPEECH_REGION=westeurope
# Changing the voice means regenerating every MP3.
AZURE_SPEECH_ITALIAN_VOICE=it-IT-ElsaNeural

ANTHROPIC_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-5

QUOTA_SCORING_CALLS_PER_DAY=150
QUOTA_LLM_CALLS_PER_DAY=100
QUOTA_TTS_CALLS_PER_DAY=0
# Counters reset at local midnight in this zone.
QUOTA_TIME_ZONE=Europe/Paris
