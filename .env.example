# Copier en `.env` et renseigner. Aucun de ces secrets n'est versionné.

# --- Base de données ---
ConnectionStrings__Default=Host=localhost;Port=5433;Database=italianapp;Username=italianapp;Password=italianapp

# --- JWT ---
# Clé de signature : >= 32 caractères. Générer avec `openssl rand -base64 48`.
Jwt__Signingdomain=
Jwt__Issuer=italian-app
Jwt__Audience=italian-app
Jwt__LifetimeHours=72

# --- Azure Speech (scoring + TTS) ---
Azure__Speech__SubscriptionKey=
Azure__Speech__Region=westeurope
# Voix figée pour le catalogue. Changer implique de regénérer les MP3 (cf. ttsVoice).
Azure__Speech__ItalianVoice=it-IT-ElsaNeural

# --- Claude (rédaction du feedback + génération de contenu) ---
Anthropic__Apidomain=
Anthropic__Model=claude-sonnet-5

# --- Quotas journaliers (cf. §7.1 du cahier des charges) ---
Quota__ScoringCallsPerDay=150
Quota__LlmCallsPerDay=100
Quota__TtsCallsPerDay=0
